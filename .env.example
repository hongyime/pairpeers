# Secrets and environment variables are managed via Infisical/Doppler.
# DO NOT add real values here.
# Run `doppler run -- command` or `infisical run -- command` to inject secrets.

# Supabase (create a free project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telegram login (current OIDC flow — https://core.telegram.org/bots/telegram-login)
# BotFather → your bot → "Login Widget" → register Allowed URLs, then copy the
# Client ID shown there. (The legacy telegram-widget.js iframe is deprecated.)
NEXT_PUBLIC_TELEGRAM_CLIENT_ID=
# Client Secret from the same BotFather screen. Only needed for the redirect
# (authorization-code) flow; the popup flow verifies via Telegram's public JWKS.
TELEGRAM_CLIENT_SECRET=

# Session signing secret (generate with: openssl rand -hex 32).
# Signs the pp_session cookie — must be long, random, and never exposed.
SESSION_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot token (server-only). Used by:
# 1) Mini App auth (/api/auth/telegram/miniapp) to validate initData HMAC signatures
#    (secret_key = HMAC_SHA256(bot_token, key="WebAppData")).
# 2) Weekly profile sync (/api/admin/sync-telegram) to refresh usernames via getChat.
# 3) Bot notifications (/api/bot/webhook) to send messages.
TELEGRAM_BOT_TOKEN=

# Secret token configured when Telegram calls POST /api/bot/webhook.
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for the Vercel Cron hitting /api/admin/sync-telegram.
CRON_SECRET=
